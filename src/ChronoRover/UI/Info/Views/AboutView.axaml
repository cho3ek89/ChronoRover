<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ChronoRover.UI.Info.ViewModels"
             mc:Ignorable="d"
             x:DataType="vm:AboutViewModel"
             x:Class="ChronoRover.UI.Info.Views.AboutView">
    <ContentPage.Header>
        <TextBlock Text="About" Classes="CmdBarHeader" />
    </ContentPage.Header>

    <NavigationPage.BackButtonContent>
        <StaticResource ResourceKey="NavPageBackButtonIcon" />
    </NavigationPage.BackButtonContent>

    <NavigationPage.TopCommandBar>
        <CommandBar>
            <CommandBar.PrimaryCommands>
                <CommandBarButton Label="GitHub" Click="GitHubClick">
                    <CommandBarButton.Icon>
                        <PathIcon Data="M94,7399 C99.523,7399 104,7403.59 104,7409.253 C104,7413.782 101.138,7417.624 97.167,7418.981 C96.66,7419.082 96.48,7418.762 96.48,7418.489 C96.48,7418.151 96.492,7417.047 96.492,7415.675 C96.492,7414.719 96.172,7414.095 95.813,7413.777 C98.04,7413.523 100.38,7412.656 100.38,7408.718 C100.38,7407.598 99.992,7406.684 99.35,7405.966 C99.454,7405.707 99.797,7404.664 99.252,7403.252 C99.252,7403.252 98.414,7402.977 96.505,7404.303 C95.706,7404.076 94.85,7403.962 94,7403.958 C93.15,7403.962 92.295,7404.076 91.497,7404.303 C89.586,7402.977 88.746,7403.252 88.746,7403.252 C88.203,7404.664 88.546,7405.707 88.649,7405.966 C88.01,7406.684 87.619,7407.598 87.619,7408.718 C87.619,7412.646 89.954,7413.526 92.175,7413.785 C91.889,7414.041 91.63,7414.493 91.54,7415.156 C90.97,7415.418 89.522,7415.871 88.63,7414.304 C88.63,7414.304 88.101,7413.319 87.097,7413.247 C87.097,7413.247 86.122,7413.234 87.029,7413.87 C87.029,7413.87 87.684,7414.185 88.139,7415.37 C88.139,7415.37 88.726,7417.2 91.508,7416.58 C91.513,7417.437 91.522,7418.245 91.522,7418.489 C91.522,7418.76 91.338,7419.077 90.839,7418.982 C86.865,7417.627 84,7413.783 84,7409.253 C84,7403.59 88.478,7399 94,7399" />
                    </CommandBarButton.Icon>
                </CommandBarButton>
            </CommandBar.PrimaryCommands>
        </CommandBar>
    </NavigationPage.TopCommandBar>

    <ContentPage.Styles>
        <Style Selector="StackPanel > StackPanel">
            <Setter Property="Spacing" Value="10" />
        </Style>
    </ContentPage.Styles>

    <ScrollViewer>
        <StackPanel Spacing="15" Margin="15,0">

            <StackPanel>
                <TextBlock Classes="heading focusable"
                           Text="ChronoRover" />

                <TextBlock Classes="text focusable"
                           Text="ChronoRover is a precise time signal generator that emulates official long-wave time broadcasts to synchronize radio-controlled watches with atomic accuracy using your phone’s speaker or headphones." />

                <TextBlock Classes="text focusable"
                           Text="Among the currently supported signals are: DCF77 (Germany), MSF (United Kingdom), WWVB (United States), JJY (Japan), and BPC (China)." />

                <TextBlock Classes="text focusable"
                           Text="Whether you’re a watch enthusiast, collector, or simply want the most accurate time possible, ChronoRover turns your smartphone into a portable time signal transmitter." />

                <TextBlock Classes="text focusable"
                           Text="Perfect solution for Casio and Citizen owners who live beyond the range of any official time signal transmission station!" />
            </StackPanel>

            <StackPanel>
                <TextBlock Classes="heading focusable" Text="Contributions" />

                <TextBlock Classes="text focusable">
                    <Run Text="Want to explore the source code, share design or feature suggestions, or report an issue? Click the" />
                    <Run Text="GitHub" TextDecorations="Underline" />
                    <Run Text="button above to open our repository." />
                </TextBlock>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</ContentPage>