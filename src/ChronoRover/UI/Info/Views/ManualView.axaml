<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="ChronoRover.UI.Info.Views.ManualView">
    <ContentPage.Header>
        <TextBlock Text="Manual" Classes="CmdBarHeader" />
    </ContentPage.Header>

    <NavigationPage.BackButtonContent>
        <StaticResource ResourceKey="NavPageBackButtonIcon" />
    </NavigationPage.BackButtonContent>

    <NavigationPage.TopCommandBar>
        <CommandBar>
            <CommandBar.PrimaryCommands>
                <CommandBarButton Label="Position" Click="WatchPositioningPicturesClick">
                    <CommandBarButton.Icon>
                        <PathIcon Data="M256.996,208.82l-9.4,9.4l-28.2-28.2c-8.4-8.4-20.9-8.4-29.2,0c-8.4,8.4-8.4,20.9,0,29.2l41.8,41.8c10.7,10.7,21.4,9.9,30.3,1l24-24c8.4-8.4,8.4-20.9,0-29.2C277.896,200.42,265.296,200.42,256.996,208.82z
M486.796,357.12l-77.6-110.2c0-41.7-15.9-83.5-47.8-115.4c-30-31.1-70.4-47.8-113.8-48l0,0l-112.8-79.4c-8.4-6.3-18.8-5.2-26.1,2.1l-102.4,102.3c-7.3,7.3-7.3,17.8-2.1,26.1c0,0,79.6,113,79.7,113.2c0.4,41.1,16.4,82.1,47.8,113.5c30.3,31.3,71,48.1,114.9,48.1c0.3,0,110.7,77.3,110.7,77.3c10.1,8.6,21.9,2.1,25.1-1l102.4-102.4C491.996,375.92,491.996,365.52,486.796,357.12z
M46.996,124.22l77.3-77.3l66.8,46.6c-22.2,8.2-42.6,21.2-59.4,38c-17.4,17.1-30.1,37.3-37.9,58.9L46.996,124.22z
M331.596,331.52c-47.5,47.5-124.6,47.5-172.1,0s-47.5-124.6,0-172.1s124.6-47.5,172.1,0S379.096,284.02,331.596,331.52z
M366.696,443.82l-63.2-44.5c21.6-8,41.4-20.8,58-38c17.3-17,29.8-36.9,37.7-58.3l44.8,63.5L366.696,443.82z" />
                    </CommandBarButton.Icon>
                </CommandBarButton>
            </CommandBar.PrimaryCommands>
        </CommandBar>
    </NavigationPage.TopCommandBar>

    <ContentPage.Styles>
        <Style Selector="Grid">
            <Setter Property="RowSpacing" Value="10" />
            <Setter Property="ColumnSpacing" Value="7" />
        </Style>

        <Style Selector="HyperlinkButton PathIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>
    </ContentPage.Styles>

    <ScrollViewer>
        <StackPanel Spacing="15" Margin="15,0">
            <TextBlock Classes="heading focusable caution"
                       Text="Caution" />
            <TextBlock Classes="title focusable caution"
                       Text="This application generates loud, high-pitched noises that may cause discomfort or potential hearing damage! Leave the room while transmission is active." />


            <TextBlock Classes="heading focusable"
                       Text="Synchronisation" />
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnDefinitions="Auto,*">
                <TextBlock Grid.Row="00" Grid.Column="0" Classes="title"
                           Text="1." />
                <TextBlock Grid.Row="00" Grid.Column="1" Classes="title focusable"
                           Text="Configure settings if needed" />
                <TextBlock Grid.Row="01" Grid.Column="1" Classes="text focusable"
                           Text="Select the correct signal type (e.g. DCF77)." />

                <TextBlock Grid.Row="02" Grid.Column="0" Classes="title"
                           Text="2." />
                <TextBlock Grid.Row="02" Grid.Column="1" Classes="title focusable"
                           Text="Set volume" />
                <TextBlock Grid.Row="03" Grid.Column="1" Classes="text focusable"
                           Text="Adjust your device volume to 80–100%." />

                <TextBlock Grid.Row="04" Grid.Column="0" Classes="title"
                           Text="3." />
                <TextBlock Grid.Row="04" Grid.Column="1" Classes="title focusable"
                           Text="Activate RC mode" />
                <TextBlock Grid.Row="05" Grid.Column="1" Classes="text focusable"
                           Text="Manually turn on the wave reception mode on your watch, per its manual." />

                <TextBlock Grid.Row="06" Grid.Column="0" Classes="title"
                           Text="4." />
                <TextBlock Grid.Row="06" Grid.Column="1" Classes="title focusable"
                           Text="Position the watch" />
                <TextBlock Grid.Row="07" Grid.Column="1" Classes="text focusable">
                    <Run
                        Text="Place it immediately adjacent to an external speaker or connected headphones for best results. The built-in speaker is an alternative, though far less reliable due to lower power." />
                    <LineBreak />
                    <Run Text="Not clear enough? Click the" />
                    <Run Text="Position" TextDecorations="Underline" />
                    <Run Text="button above to see images of the correct watch position." />
                </TextBlock>

                <TextBlock Grid.Row="08" Grid.Column="0" Classes="title"
                           Text="5." />
                <TextBlock Grid.Row="08" Grid.Column="1" Classes="title focusable"
                           Text="Start transmission" />
                <TextBlock Grid.Row="09" Grid.Column="1" Classes="text focusable"
                           Text="Tap Play." />

                <TextBlock Grid.Row="10" Grid.Column="0" Classes="title"
                           Text="6." />
                <TextBlock Grid.Row="10" Grid.Column="1" Classes="title focusable"
                           Text="Wait" />
                <TextBlock Grid.Row="11" Grid.Column="1" Classes="text focusable"
                           Text="Wait 3–7 minutes for synchronisation completeness." />

                <TextBlock Grid.Row="12" Grid.Column="0" Classes="title"
                           Text="7." />
                <TextBlock Grid.Row="12" Grid.Column="1" Classes="title focusable"
                           Text="Stop transmission" />
                <TextBlock Grid.Row="13" Grid.Column="1" Classes="text focusable"
                           Text="Upon sync completion, press the Stop button." />
            </Grid>


            <TextBlock Classes="heading focusable"
                       Text="Troubleshooting" />
            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
                  ColumnDefinitions="Auto, *">
                <TextBlock Grid.Row="00" Grid.Column="0" Classes="title"
                           Text="-" />
                <TextBlock Grid.Row="00" Grid.Column="1" Classes="title focusable"
                           Text="Wrong signal type" />
                <TextBlock Grid.Row="01" Grid.Column="1" Classes="text focusable">
                    <Run Text="Confirm the selected signal type aligns with your watch's capabilities." />
                    <LineBreak />
                    <Run Text="On some watches (like Casio or Citizen), the receivable signal type depends on the set home city. For example, if your watch's home city is set to BER, choose DCF77." />
                </TextBlock>

                <TextBlock Grid.Row="02" Grid.Column="0" Classes="title"
                           Text="-" />
                <TextBlock Grid.Row="02" Grid.Column="1" Classes="title focusable"
                           Text="Insufficient signal power" />
                <TextBlock Grid.Row="03" Grid.Column="1" Classes="text focusable"
                           Text="Make sure the volume is high enough. Keep the watch as close to the speaker as possible. Try using external speaker or a headset if you are not, if you are try different one." />

                <TextBlock Grid.Row="04" Grid.Column="0" Classes="title"
                           Text="-" />
                <TextBlock Grid.Row="04" Grid.Column="1" Classes="title focusable"
                           Text="Signal interferences" />
                <TextBlock Grid.Row="05" Grid.Column="1" Classes="text focusable"
                           Text="Background noise, music, or other sounds may interfere with the time signal and cause synchronization to fail. For optimal results, use the application in a quiet room." />

                <TextBlock Grid.Row="06" Grid.Column="0" Classes="title"
                           Text="-" />
                <TextBlock Grid.Row="06" Grid.Column="1" Classes="title focusable"
                           Text="Watch is slow after synchronization" />
                <TextBlock Grid.Row="07" Grid.Column="1" Classes="text focusable">
                    <Run Text="Your watch may be a few hundred milliseconds slow after synchronization. This can occasionally be caused by the headset you are using. Try another one!" />
                    <LineBreak />
                    <Run Text="During our testing, the simplest and cheapest cable models delivered the best (and perfect) accuracy." />
                </TextBlock>
            </Grid>
        </StackPanel>
    </ScrollViewer>

</ContentPage>