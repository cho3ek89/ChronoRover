<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:v="using:ChronoRover.UI.Signal.Views"
             xmlns:vm="using:ChronoRover.UI.Signal.ViewModels"
             mc:Ignorable="d"
             x:DataType="vm:SignalViewModel"
             x:Class="ChronoRover.UI.Signal.Views.SignalView">
    <ContentPage.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Chrono" Classes="CmdBarHeader" />
            <TextBlock Text="Rover" Classes="CmdBarHeader"
                       FontFamily="{StaticResource Exo2Bold}" />
        </StackPanel>
    </ContentPage.Header>

    <NavigationPage.TopCommandBar>
        <CommandBar>
            <CommandBar.PrimaryCommands>
                <CommandBarButton Label="Signal" Click="SignalTypeSelectButtonClicked">
                    <CommandBarButton.Icon>
                        <PathIcon Data="M21,14 L19,14 L19,10 L21,10 L21,14 Z M17,16 L15,16 L15,8 L17,8 L17,16 Z M13,19 L11,19 L11,5 L13,5 L13,19 Z M9,16 L7,16 L7,8 L9,8 L9,16 Z M5,14 L3,14 L3,10 L5,10 L5,14 Z" />
                    </CommandBarButton.Icon>
                </CommandBarButton>
                <CommandBarButton Label="Info" Click="InfoButtonClicked">
                    <CommandBarButton.Icon>
                        <PathIcon Data="M16.247 4.733c0 1.684 1.271 2.825 2.84 2.825s2.842-1.142 2.842-2.825c0-1.685-1.272-2.826-2.842-2.826-1.568 0-2.84 1.141-2.84 2.826zM10.096 14.375c0 0.334-0.061 1.163 0.008 1.662l2.479-2.983c0.513-0.562 1.106-0.955 1.409-0.849s0.47 0.463 0.371 0.795l-4.103 13.59c-0.473 1.588 0.421 3.148 2.599 3.504 3.189 0 5.084-2.158 6.948-4.955 0-0.334 0.111-1.213 0.044-1.713l-2.479 2.982c-0.514 0.562-1.151 0.955-1.455 0.85-0.28-0.098-0.444-0.41-0.389-0.721l4.132-13.653c0.344-1.734-0.59-3.312-2.564-3.514-2.076 0.001-5.136 2.209-7 5.005z" />
                    </CommandBarButton.Icon>
                </CommandBarButton>
            </CommandBar.PrimaryCommands>
        </CommandBar>
    </NavigationPage.TopCommandBar>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" MinHeight="100" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="50" />
            <RowDefinition Height="2*" MinHeight="50" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Viewbox Grid.Row="0"
                 Margin="0,5,0,0"
                 Stretch="Uniform"
                 StretchDirection="Both">
            <v:DateTimeSignalTypeView DataContext="{Binding DateTimeSignalTypeViewModel, Mode=OneTime}"
                                      VerticalContentAlignment="Center"
                                      HorizontalContentAlignment="Stretch" />
        </Viewbox>

        <v:LevelsView Grid.Row="1"
                      DataContext="{Binding LevelsViewModel, Mode=OneTime}"
                      Margin="5,0" />

        <v:WaveChartView Grid.Row="2"
                         DataContext="{Binding WaveChartViewModel, Mode=OneTime}"
                         Margin="0,10,5,0" />

        <v:SpectrumChartView Grid.Row="3"
                             DataContext="{Binding SpectrumChartViewModel, Mode=OneTime}" />

        <StackPanel Grid.Row="4" Margin="0,20,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
            <Button Classes="large" Command="{Binding PlayCommand}">
                <PathIcon Data="M320-203v-560l440 280-440 280Zm60-280Zm0 171 269-171-269-171v342Z" />
            </Button>

            <Button Classes="large" Command="{Binding StopCommand}">
                <PathIcon Data="M300-660v360-360Zm-60 420v-480h480v480H240Zm60-60h360v-360H300v360Z" />
            </Button>
        </StackPanel>

    </Grid>
</ContentPage>